// Prisma schema for WiseKids Role-Based Learning Management Portal
// Supports SQLite (local dev) and PostgreSQL (production via DATABASE_URL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// AUTHENTICATION & USERS
// ==========================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("STUDENT") // ADMIN, TEACHER, STUDENT
  status        String    @default("ACTIVE")  // ACTIVE, PENDING_APPROVAL, SUSPENDED
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  profile         Profile?
  taughtCourses   Course[]         @relation("TeacherCourses")
  enrollments     Enrollment[]
  taughtBatches   Batch[]          @relation("TeacherBatches")
  submissions     Submission[]
  quizAttempts    QuizAttempt[]
  attendance      Attendance[]     @relation("StudentAttendance")
  markedAttendance Attendance[]    @relation("TeacherMarkedAttendance")
  announcements   Announcement[]   @relation("AuthorAnnouncements")
  sentMessages    Message[]        @relation("SentMessages")
  receivedMessages Message[]       @relation("ReceivedMessages")
  notifications   Notification[]
  payments        Payment[]
  certificates    Certificate[]
  auditLogs       AuditLog[]
  createdAssignments Assignment[]  @relation("TeacherAssignments")
  createdQuizzes  Quiz[]           @relation("TeacherQuizzes")

  @@index([email])
  @@index([role])
  @@index([status])
}

model Profile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                String?
  phone              String?
  address            String?
  avatar             String?
  qualifications     String?
  subjectsTaught     String?
  gradeLevel         String?
  parentName         String?
  parentPhone        String?
  notificationPrefs  String?  @default("{\"email\":true,\"app\":true}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ==========================================
// COURSES & CURRICULUM
// ==========================================

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  icon        String?  @default("Sparkles")
  description String?
  color       String?  @default("#4F46E5")
  courses     Course[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Course {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  shortDesc   String?
  thumbnail   String?
  price       Float    @default(0.0)
  isFree      Boolean  @default(false)
  level       String   @default("Beginner") // Beginner, Intermediate, Advanced
  status      String   @default("PUBLISHED") // DRAFT, PENDING_APPROVAL, PUBLISHED, ARCHIVED
  featured    Boolean  @default(false)
  ageGroup    String?  @default("6-12 Years")
  durationWeeks Int    @default(8)
  
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  teacherId   String
  teacher     User      @relation("TeacherCourses", fields: [teacherId], references: [id], onDelete: Cascade)

  modules       Module[]
  enrollments   Enrollment[]
  batches       Batch[]
  assignments   Assignment[]
  quizzes       Quiz[]
  certificates  Certificate[]
  payments      Payment[]
  announcements Announcement[] @relation("CourseAnnouncements")
  attendance    Attendance[]
  messages      Message[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([teacherId])
  @@index([categoryId])
  @@index([status])
  @@index([featured])
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  
  lessons     Lesson[]
  assignments Assignment[]
  quizzes     Quiz[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([courseId])
}

model Lesson {
  id              String   @id @default(cuid())
  moduleId        String
  module          Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  order           Int      @default(0)
  contentType     String   @default("VIDEO") // VIDEO, PDF, TEXT, SLIDE
  contentUrl      String?
  contentText     String?
  durationMinutes Int      @default(15)
  isFreePreview   Boolean  @default(false)

  progress        LessonProgress[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([moduleId])
}

model LessonProgress {
  id                  String    @id @default(cuid())
  userId              String
  lessonId            String
  lesson              Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  isCompleted         Boolean   @default(false)
  completedAt         DateTime?
  lastPositionSeconds Int       @default(0)
  
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

// ==========================================
// ENROLLMENTS & BATCHES
// ==========================================

model Enrollment {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId           String
  course             Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  batchId            String?
  batch              Batch?    @relation(fields: [batchId], references: [id], onDelete: SetNull)
  status             String    @default("ACTIVE") // ACTIVE, COMPLETED, DROPPED
  progressPercentage Int       @default(0)
  enrolledAt         DateTime  @default(now())
  completedAt        DateTime?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([status])
}

model Batch {
  id           String       @id @default(cuid())
  name         String
  code         String       @unique
  courseId     String
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacherId    String
  teacher      User         @relation("TeacherBatches", fields: [teacherId], references: [id], onDelete: Cascade)
  startDate    DateTime     @default(now())
  endDate      DateTime?
  maxStudents  Int          @default(25)
  scheduleText String?      @default("Mon, Wed, Fri 4:00 PM - 5:00 PM")
  meetingLink  String?      @default("https://meet.google.com/wis-ekid-cls")

  enrollments  Enrollment[]
  attendance   Attendance[]
  announcements Announcement[] @relation("BatchAnnouncements")

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([courseId])
  @@index([teacherId])
}

// ==========================================
// ASSIGNMENTS & SUBMISSIONS
// ==========================================

model Assignment {
  id               String       @id @default(cuid())
  courseId         String
  course           Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleId         String?
  module           Module?      @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  teacherId        String
  teacher          User         @relation("TeacherAssignments", fields: [teacherId], references: [id], onDelete: Cascade)
  title            String
  instructions     String
  attachmentUrl    String?
  dueDate          DateTime
  maxMarks         Int          @default(100)
  allowResubmission Boolean     @default(true)
  
  submissions      Submission[]

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([courseId])
  @@index([teacherId])
}

model Submission {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fileUrl      String?
  comments     String?
  marks        Float?
  feedback     String?
  status       String     @default("PENDING") // PENDING, GRADED, RESUBMIT_REQUESTED, LATE
  submittedAt  DateTime   @default(now())
  gradedAt     DateTime?

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
  @@index([status])
}

// ==========================================
// QUIZZES & ASSESSMENTS
// ==========================

model Quiz {
  id                 String        @id @default(cuid())
  courseId           String
  course             Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleId           String?
  module             Module?       @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  teacherId          String
  teacher            User          @relation("TeacherQuizzes", fields: [teacherId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  timeLimitMinutes   Int           @default(15)
  passingScore       Int           @default(70) // Percentage
  randomizeQuestions Boolean       @default(false)
  isPublished        Boolean       @default(true)

  questions          Question[]
  attempts           QuizAttempt[]

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([courseId])
  @@index([teacherId])
}

model Question {
  id          String   @id @default(cuid())
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text        String
  type        String   @default("MCQ") // MCQ, TRUE_FALSE, SHORT_ANSWER
  points      Int      @default(10)
  order       Int      @default(0)
  explanation String?

  options     Option[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([quizId])
}

model Option {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([questionId])
}

model QuizAttempt {
  id          String    @id @default(cuid())
  quizId      String
  quiz        Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId   String
  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score       Float     @default(0)
  maxScore    Float     @default(100)
  passed      Boolean   @default(false)
  answersJson String?   // Stored user answers as JSON string
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([quizId])
  @@index([studentId])
}

// ==========================================
// ATTENDANCE & LIVE CLASSES
// ==========================================

model Attendance {
  id         String   @id @default(cuid())
  batchId    String?
  batch      Batch?   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId  String
  student    User     @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Cascade)
  markedById String
  markedBy   User     @relation("TeacherMarkedAttendance", fields: [markedById], references: [id], onDelete: Cascade)
  date       DateTime @default(now())
  status     String   @default("PRESENT") // PRESENT, ABSENT, LATE, EXCUSED
  notes      String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([batchId, studentId, date])
  @@index([studentId])
  @@index([batchId])
  @@index([date])
}

// ==========================================
// ANNOUNCEMENTS & MESSAGING
// ==========================================

model Announcement {
  id             String   @id @default(cuid())
  authorId       String
  author         User     @relation("AuthorAnnouncements", fields: [authorId], references: [id], onDelete: Cascade)
  title          String
  content        String
  targetRole     String   @default("ALL") // ALL, ADMIN, TEACHER, STUDENT
  targetBatchId  String?
  targetBatch    Batch?   @relation("BatchAnnouncements", fields: [targetBatchId], references: [id], onDelete: SetNull)
  targetCourseId String?
  targetCourse   Course?  @relation("CourseAnnouncements", fields: [targetCourseId], references: [id], onDelete: SetNull)
  isPinned       Boolean  @default(false)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([authorId])
  @@index([targetRole])
  @@index([isPinned])
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  courseId   String?
  course     Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  subject    String?
  content    String
  isRead     Boolean  @default(false)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([senderId])
  @@index([receiverId])
  @@index([isRead])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("SYSTEM") // ASSIGNMENT, GRADE, ANNOUNCEMENT, CLASS, SYSTEM
  link      String?
  isRead    Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isRead])
}

// ==========================================
// PAYMENTS, CERTIFICATES & AUDIT
// ==========================================

model Payment {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  amount        Float
  currency      String   @default("USD")
  status        String   @default("COMPLETED") // COMPLETED, PENDING, FAILED, REFUNDED
  invoiceNumber String   @unique
  paymentMethod String   @default("CARD") // CARD, PAYPAL, STRIPE, BANK_TRANSFER
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([courseId])
  @@index([status])
}

model Certificate {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId          String
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  certificateNumber String   @unique
  verificationCode  String   @unique
  pdfUrl            String?
  issuedAt          DateTime @default(now())

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String   // e.g. "USER_ROLE_CHANGED", "COURSE_APPROVED", "GRADE_SUBMITTED"
  entity      String   // e.g. "User", "Course", "Submission"
  entityId    String?
  detailsJson String?  // JSON string containing previous/new values
  ipAddress   String?  @default("127.0.0.1")
  userAgent   String?  @default("Web Browser")

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ==========================================
// MARKETING & CMS SETTINGS
// ==========================================

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  status    String   @default("UNREAD") // UNREAD, READ, REPLIED
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  type      String   @default("STRING") // STRING, JSON, BOOLEAN, NUMBER
  updatedAt DateTime @updatedAt
}
